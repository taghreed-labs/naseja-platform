@section('scripts')

<script>

function togglePassword(inputId, button) {

    const input = document.getElementById(inputId);

    if (input.type === 'password') {

        input.type = 'text';

        button.style.opacity = '1';

    } else {

        input.type = 'password';

        button.style.opacity = '.55';

    }

}

</script>

