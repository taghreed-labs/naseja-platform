<script>

    let deferredPrompt = null;


    /*
    |--------------------------------------------------------------------------
    | ظهور نافذة التثبيت
    |--------------------------------------------------------------------------
    */

    window.addEventListener(
        'beforeinstallprompt',
        function (event) {

            event.preventDefault();

            deferredPrompt = event;


            console.log(
                'NASEJA PWA: التطبيق جاهز للتثبيت.'
            );


            /*
            |--------------------------------------------------------------------------
            | إظهار زر التثبيت
            |--------------------------------------------------------------------------
            */

            const installButton =
                document.getElementById(
                    'pwa-install-btn'
                );


            if (installButton) {

                installButton.style.display = 'inline-flex';

            }

        }
    );


    /*
    |--------------------------------------------------------------------------
    | تثبيت NASEJA
    |--------------------------------------------------------------------------
    */

    async function installNaseja() {


        /*
        |--------------------------------------------------------------------------
        | إذا لم يكن التثبيت متاحًا
        |--------------------------------------------------------------------------
        */

        if (!deferredPrompt) {

            console.log(
                'NASEJA PWA: التثبيت غير متاح حاليًا.'
            );

            return;

        }


        /*
        |--------------------------------------------------------------------------
        | عرض نافذة التثبيت
        |--------------------------------------------------------------------------
        */

        deferredPrompt.prompt();


        /*
        |--------------------------------------------------------------------------
        | معرفة اختيار المستخدم
        |--------------------------------------------------------------------------
        */

        const { outcome } =
            await deferredPrompt.userChoice;


        console.log(
            'NASEJA PWA:',
            outcome === 'accepted'
                ? 'تم قبول التثبيت.'
                : 'تم رفض التثبيت.'
        );


        /*
        |--------------------------------------------------------------------------
        | التخلص من الحدث بعد الاستخدام
        |--------------------------------------------------------------------------
        */

        deferredPrompt = null;


        /*
        |--------------------------------------------------------------------------
        | إخفاء الزر
        |--------------------------------------------------------------------------
        */

        const installButton =
            document.getElementById(
                'pwa-install-btn'
            );


        if (installButton) {

            installButton.style.display = 'none';

        }

    }


    /*
    |--------------------------------------------------------------------------
    | بعد تثبيت التطبيق
    |--------------------------------------------------------------------------
    */

    window.addEventListener(
        'appinstalled',
        function () {

            console.log(
                'NASEJA PWA: تم تثبيت التطبيق بنجاح.'
            );


            const installButton =
                document.getElementById(
                    'pwa-install-btn'
                );


            if (installButton) {

                installButton.style.display = 'none';

            }

        }
    );

</script>


