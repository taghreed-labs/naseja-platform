    <script>
        (function () {
            try {
                var language = localStorage.getItem('naseja_language') || 'ar';
                var themePreference = localStorage.getItem('naseja_theme') || 'light';
                var fontSize = localStorage.getItem('naseja_font_size') || 'normal';
                var reducedMotion = localStorage.getItem('naseja_reduced_motion') === '1';

                var theme = themePreference;

                if (themePreference === 'system' && window.matchMedia) {
                    theme = window.matchMedia('(prefers-color-scheme: dark)').matches
                        ? 'dark'
                        : 'light';
                }

                document.documentElement.lang = language === 'en' ? 'en' : 'ar';
                document.documentElement.dir = language === 'en' ? 'ltr' : 'rtl';
                document.documentElement.dataset.themePreference = themePreference;
                document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
                document.documentElement.dataset.fontSize = ['small', 'normal', 'large'].includes(fontSize)
                    ? fontSize
                    : 'normal';

                if (reducedMotion) {
                    document.documentElement.dataset.reducedMotion = 'true';
                }
            } catch (e) {}
        })();
    </script>


