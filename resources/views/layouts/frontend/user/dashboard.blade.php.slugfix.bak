    <style>
        /* =====================================================
           SEARCH RESULTS
        ====================================================== */

        .dashboard-search-results {
            margin-bottom: 32px;
            animation: searchFadeIn .35s ease;
        }

        @keyframes searchFadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dashboard-search-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 20px;
            padding: 20px 22px;
            background: linear-gradient(135deg, #ffffff 0%, #faf9ff 100%);
            border: 1px solid #eceaf5;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(55, 45, 120, .05);
        }

        .dashboard-search-header-content {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .dashboard-search-main-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: linear-gradient(135deg, #eeeaff, #f6f4ff);
            color: #5e4ed0;
        }

        .dashboard-search-main-icon svg {
            width: 22px;
            height: 22px;
            stroke-width: 2;
        }

        .dashboard-search-header h2 {
            margin: 0;
            color: #25252d;
            font-size: 21px;
            font-weight: 900;
        }

        .dashboard-search-header p {
            margin: 5px 0 0;
            color: #8a8995;
            font-size: 13px;
            line-height: 1.7;
        }

        .dashboard-search-header p strong {
            color: #5e4ed0;
            font-weight: 900;
        }

        .dashboard-search-clear {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 40px;
            padding: 9px 14px;
            border-radius: 11px;
            background: #f1efff;
            color: #5e4ed0;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            transition: .2s ease;
            white-space: nowrap;
        }

        .dashboard-search-clear svg {
            width: 15px;
            height: 15px;
        }

        .dashboard-search-clear:hover {
            background: #e7e3ff;
            transform: translateY(-1px);
        }


        /* =====================================================
           SEARCH GROUP
        ====================================================== */

        .dashboard-search-group {
            margin-bottom: 25px;
        }

        .dashboard-search-group:last-child {
            margin-bottom: 0;
        }

        .dashboard-search-group-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 13px;
        }

        .dashboard-search-group-title-left {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .dashboard-search-group-icon {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #f5f3ff;
            color: #5e4ed0;
        }

        .dashboard-search-group-icon svg {
            width: 17px;
            height: 17px;
        }

        .dashboard-search-group-title h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 900;
            color: #303039;
        }

        .dashboard-search-count {
            min-width: 27px;
            height: 27px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 8px;
            border-radius: 9px;
            background: #eeeaff;
            color: #5e4ed0;
            font-size: 11px;
            font-weight: 900;
        }


        /* =====================================================
           SEARCH GRID
        ====================================================== */

        .dashboard-search-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }


        /* =====================================================
           SEARCH CARD
        ====================================================== */

        .dashboard-search-card {
            position: relative;
            min-width: 0;
            overflow: hidden;
            padding: 18px;
            background: #ffffff;
            border: 1px solid #e9e8ef;
            border-radius: 18px;
            text-decoration: none;
            color: #25252d;
            transition:
                transform .22s ease,
                box-shadow .22s ease,
                border-color .22s ease;
        }

        .dashboard-search-card::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, #5e4ed0, #9b8df0);
            opacity: 0;
            transition: .2s ease;
        }

        .dashboard-search-card:hover {
            transform: translateY(-3px);
            border-color: #d9d4ff;
            box-shadow: 0 12px 30px rgba(80, 65, 170, .09);
        }

        .dashboard-search-card:hover::before {
            opacity: 1;
        }


        /* =====================================================
           USER CARD
        ====================================================== */

        .dashboard-search-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dashboard-search-avatar {
            width: 50px;
            height: 50px;
            min-width: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 15px;
            background: linear-gradient(135deg, #5e4ed0, #8c7de6);
            color: #ffffff;
            font-size: 18px;
            font-weight: 900;
            box-shadow: 0 5px 15px rgba(94, 78, 208, .15);
        }

        .dashboard-search-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .dashboard-search-user-info {
            min-width: 0;
        }

        .dashboard-search-card h4 {
            margin: 0;
            color: #282832;
            font-size: 14px;
            font-weight: 900;
            line-height: 1.5;
        }

        .dashboard-search-card small {
            display: block;
            margin-top: 4px;
            color: #92929d;
            font-size: 11px;
            font-weight: 600;
            line-height: 1.6;
        }


        /* =====================================================
           TAGS
        ====================================================== */

        .dashboard-search-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 15px;
        }

        .dashboard-search-tag {
            display: inline-flex;
            align-items: center;
            padding: 5px 9px;
            border-radius: 8px;
            background: #f5f3ff;
            color: #5e4ed0;
            font-size: 10px;
            font-weight: 800;
        }


        /* =====================================================
           SERVICE / PORTFOLIO ICON
        ====================================================== */

        .dashboard-search-service-icon,
        .dashboard-search-work-icon {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            border-radius: 13px;
            background: #f1efff;
            color: #5e4ed0;
        }

        .dashboard-search-service-icon {
            background: #eef7ff;
            color: #3887c9;
        }

        .dashboard-search-work-icon {
            background: #fff5ea;
            color: #dc8b3c;
        }

        .dashboard-search-service-icon svg,
        .dashboard-search-work-icon svg {
            width: 20px;
            height: 20px;
        }

        .dashboard-search-card p {
            margin: 7px 0 0;
            color: #858590;
            font-size: 11px;
            line-height: 1.9;
            font-weight: 500;

            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .dashboard-search-provider {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 13px;
            padding-top: 11px;
            border-top: 1px solid #f0eff4;
            color: #92929d;
            font-size: 10px;
            font-weight: 700;
        }

        .dashboard-search-provider strong {
            color: #5e4ed0;
            font-weight: 900;
        }


        /* =====================================================
           EMPTY SEARCH
        ====================================================== */

        .dashboard-search-empty {
            padding: 42px 25px;
            background: #ffffff;
            border: 1px solid #ebeaf0;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(55, 45, 120, .04);
        }

        .dashboard-search-empty-icon {
            width: 58px;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 13px;
            border-radius: 17px;
            background: #f5f3ff;
            color: #6b5bd5;
        }

        .dashboard-search-empty-icon svg {
            width: 27px;
            height: 27px;
        }

        .dashboard-search-empty strong {
            display: block;
            margin-bottom: 5px;
            color: #303039;
            font-size: 15px;
            font-weight: 900;
        }

        .dashboard-search-empty span {
            display: block;
            color: #96959f;
            font-size: 12px;
            line-height: 1.8;
        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 1050px) {

            .dashboard-search-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

        }


        @media (max-width: 700px) {

            .dashboard-search-header {
                align-items: flex-start;
                flex-direction: column;
                padding: 17px;
            }

            .dashboard-search-header-content {
                width: 100%;
            }

            .dashboard-search-clear {
                width: 100%;
            }

            .dashboard-search-grid {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 450px) {

            .dashboard-search-header-content {
                align-items: flex-start;
            }

            .dashboard-search-main-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
            }

            .dashboard-search-header h2 {
                font-size: 18px;
            }

            .dashboard-search-header p {
                font-size: 11px;
            }

            .dashboard-search-card {
                padding: 15px;
            }

        }


        /* =====================================================
           SETTINGS PANEL
        ====================================================== */
        .dashboard-topbar-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
        .dashboard-settings-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 14px;border:1px solid #e6e3f2;border-radius:12px;background:#fff;color:#4d456e;font:inherit;font-size:12px;font-weight:800;cursor:pointer;transition:.2s ease}
        .dashboard-settings-btn:hover{transform:translateY(-1px);border-color:#d5cff8;background:#f8f6ff}
        .dashboard-settings-btn svg{width:17px;height:17px}
        .settings-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(20,18,32,.45);backdrop-filter:blur(5px)}
        .settings-modal.is-open{display:flex}
        .settings-card{width:min(520px,100%);max-height:90vh;overflow:auto;background:#fff;border:1px solid #e9e7f1;border-radius:22px;box-shadow:0 24px 70px rgba(28,22,70,.22)}
        .settings-header{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:20px 22px;border-bottom:1px solid #efedf5}
        .settings-header h2{margin:0;font-size:19px;font-weight:900;color:#282631}
        .settings-close{width:38px;height:38px;border:0;border-radius:11px;background:#f5f3fa;color:#5e596c;cursor:pointer;display:flex;align-items:center;justify-content:center}
        .settings-close svg{width:18px;height:18px}
        .settings-body{padding:20px 22px}
        .settings-group{padding:16px 0;border-bottom:1px solid #f0eef5}
        .settings-group:first-child{padding-top:0}.settings-group:last-child{border-bottom:0;padding-bottom:0}
        .settings-label{display:block;margin-bottom:10px;font-size:12px;font-weight:900;color:#716d7e}
        .settings-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
        .settings-options.two{grid-template-columns:repeat(2,minmax(0,1fr))}
        .settings-option{position:relative}
        .settings-option input{position:absolute;opacity:0;pointer-events:none}
        .settings-option label{display:flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:9px 10px;border:1px solid #e8e5ef;border-radius:11px;background:#faf9fc;color:#575362;font-size:12px;font-weight:800;cursor:pointer;transition:.2s ease;text-align:center}
        .settings-option input:checked+label{border-color:#7161da;background:#f0edff;color:#5e4ed0;box-shadow:0 0 0 2px rgba(94,78,208,.08)}
        .settings-row{display:flex;align-items:center;justify-content:space-between;gap:16px}
        .settings-row-text strong{display:block;font-size:13px;color:#373440}.settings-row-text span{display:block;margin-top:4px;font-size:11px;color:#918d9c}
        .settings-switch{position:relative;width:46px;height:26px;flex:0 0 46px}
        .settings-switch input{opacity:0;width:0;height:0}.settings-slider{position:absolute;inset:0;background:#d9d6df;border-radius:99px;cursor:pointer;transition:.2s}.settings-slider:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;box-shadow:0 2px 5px rgba(0,0,0,.2);transition:.2s}.settings-switch input:checked+.settings-slider{background:#6757d3}.settings-switch input:checked+.settings-slider:before{transform:translateX(20px)}
        html[dir="rtl"] .settings-switch input:checked+.settings-slider:before{transform:translateX(-20px)}
        html[dir="rtl"] .settings-slider:before{left:auto;right:3px}
        .settings-reset{width:100%;min-height:42px;border:1px solid #eadede;border-radius:11px;background:#fff8f8;color:#b45252;font:inherit;font-size:12px;font-weight:900;cursor:pointer}
        html[data-naseja-font="small"]{font-size:14px}html[data-naseja-font="large"]{font-size:18px}
        html[data-naseja-reduce-motion="1"] *,html[data-naseja-reduce-motion="1"] *::before,html[data-naseja-reduce-motion="1"] *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}

        /* Dark theme */
        html[data-naseja-theme="dark"] body{background:#111218!important;color:#ececf2!important}
        html[data-naseja-theme="dark"] .naseja-dashboard{color:#ececf2}
        html[data-naseja-theme="dark"] .profile-overview,
        html[data-naseja-theme="dark"] .actions-panel,
        html[data-naseja-theme="dark"] .overview-section,
        html[data-naseja-theme="dark"] .dashboard-tip,
        html[data-naseja-theme="dark"] .public-profile-card,
        html[data-naseja-theme="dark"] .dashboard-search-header,
        html[data-naseja-theme="dark"] .dashboard-search-card,
        html[data-naseja-theme="dark"] .dashboard-search-empty,
        html[data-naseja-theme="dark"] .settings-card{background:#1b1d25!important;border-color:#2b2e39!important;color:#ededf3!important}
        html[data-naseja-theme="dark"] h1,html[data-naseja-theme="dark"] h2,html[data-naseja-theme="dark"] h3,html[data-naseja-theme="dark"] h4,html[data-naseja-theme="dark"] strong{color:#f4f4f8!important}
        html[data-naseja-theme="dark"] p,html[data-naseja-theme="dark"] small,html[data-naseja-theme="dark"] .settings-row-text span{color:#aaaeba!important}
        html[data-naseja-theme="dark"] .dashboard-settings-btn,
        html[data-naseja-theme="dark"] .settings-option label,
        html[data-naseja-theme="dark"] .settings-close{background:#242732!important;border-color:#343846!important;color:#e4e5ec!important}
        html[data-naseja-theme="dark"] .settings-option input:checked+label{background:#312c52!important;border-color:#7567d8!important;color:#c8c1ff!important}
        html[data-naseja-theme="dark"] .settings-header,html[data-naseja-theme="dark"] .settings-group{border-color:#30333e!important}
        html[data-naseja-theme="dark"] .action-item,html[data-naseja-theme="dark"] .overview-stat{background:#20232c!important;border-color:#30343f!important}
        @media(max-width:700px){.dashboard-topbar-actions{width:100%}.dashboard-settings-btn,.dashboard-edit-btn{flex:1}.settings-options{grid-template-columns:1fr}.settings-options.two{grid-template-columns:1fr 1fr}}


        /* =====================================================
           ACCOUNT APPROVAL STATUS
        ====================================================== */

        .account-review-banner {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin: 0 0 26px;
            padding: 17px 19px;
            border: 1px solid transparent;
            border-radius: 17px;
            box-shadow: 0 8px 24px rgba(38, 38, 50, .04);
        }

        .account-review-banner .review-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
        }

        .account-review-banner .review-icon svg {
            width: 20px;
            height: 20px;
        }

        .account-review-banner .review-content {
            min-width: 0;
        }

        .account-review-banner h3 {
            margin: 0 0 4px;
            font-size: 14px;
            font-weight: 900;
            line-height: 1.6;
        }

        .account-review-banner p {
            margin: 0;
            font-size: 11.5px;
            font-weight: 600;
            line-height: 1.9;
        }

        .account-review-banner.pending {
            background: #fffaf0;
            border-color: #f3dfb4;
            color: #8f671d;
        }

        .account-review-banner.pending .review-icon {
            background: #fff0c8;
            color: #b87911;
        }

        .account-review-banner.approved {
            background: #f2fbf7;
            border-color: #d4eee2;
            color: #287a5d;
        }

        .account-review-banner.approved .review-icon {
            background: #dcf4e8;
            color: #23825f;
        }

        .account-review-banner.rejected {
            background: #fff5f5;
            border-color: #f2d4d8;
            color: #a84a54;
        }

        .account-review-banner.rejected .review-icon {
            background: #ffe4e7;
            color: #c94c59;
        }

    </style>
@endpush


