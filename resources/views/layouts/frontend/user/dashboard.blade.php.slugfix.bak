{{-- =========================================================
     AUTO SYNC APPROVAL STATUS
     يفحص حالة اعتماد الحساب تلقائيًا ويحدث التنبيه فقط
     بدون إعادة تحميل الصفحة وبدون Ctrl+F5
========================================================= --}}
<script>
(function () {
    'use strict';

    let approvalSyncInProgress = false;

    async function syncApprovalStatus() {
        if (approvalSyncInProgress || document.hidden) {
            return;
        }

        const currentArea = document.getElementById('accountApprovalStatusArea');

        if (!currentArea) {
            return;
        }

        approvalSyncInProgress = true;

        try {
            const freshUrl = new URL(window.location.href);

            /*
             * باراميتر متغير لمنع المتصفح من إعادة نسخة قديمة.
             * لا يؤثر على مسار Laravel أو بيانات الصفحة.
             */
            freshUrl.searchParams.set('_naseja_fresh', Date.now().toString());

            const response = await fetch(freshUrl.toString(), {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {
                    'Accept': 'text/html',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                return;
            }

            const html = await response.text();
            const parser = new DOMParser();
            const freshDocument = parser.parseFromString(html, 'text/html');

            const freshArea =
                freshDocument.getElementById('accountApprovalStatusArea');

            if (!freshArea) {
                return;
            }

            const oldStatus =
                currentArea.getAttribute('data-approval-status');

            const newStatus =
                freshArea.getAttribute('data-approval-status');

            if (oldStatus !== newStatus) {
                currentArea.replaceWith(freshArea);

                /*
                 * إعادة رسم أيقونات Lucide داخل التنبيه الجديد.
                 */
                if (
                    window.lucide &&
                    typeof window.lucide.createIcons === 'function'
                ) {
                    window.lucide.createIcons();
                }
            }
        } catch (error) {
            /*
             * لو حصل انقطاع مؤقت بالاتصال، لا نظهر خطأ للمستخدم.
             * المحاولة التالية ستتم تلقائيًا.
             */
            console.debug(
                'NASEJA approval status sync skipped:',
                error
            );
        } finally {
            approvalSyncInProgress = false;
        }
    }

    /*
     * فحص تلقائي كل 5 ثوانٍ أثناء بقاء المستخدم في الداشبورد.
     */
    window.setInterval(syncApprovalStatus, 5000);

    /*
     * فحص فوري عند الرجوع إلى تبويب الداشبورد.
     */
    document.addEventListener('visibilitychange', function () {
        if (!document.hidden) {
            syncApprovalStatus();
        }
    });

    /*
     * فحص فوري عند الرجوع إلى نافذة المتصفح.
     */
    window.addEventListener('focus', syncApprovalStatus);

    /*
     * فحص أولي بعد فتح الصفحة.
     */
    document.addEventListener('DOMContentLoaded', function () {
        window.setTimeout(syncApprovalStatus, 1200);
    });
})();
</script>


@endsection